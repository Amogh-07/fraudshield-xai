{
  "manifest_version": 3,
  "name": "FraudShield XAI",
  "version": "1.1",
  "description": "Warns you about risky merchants before you enter card details.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*", "https://*.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "FraudShield" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
